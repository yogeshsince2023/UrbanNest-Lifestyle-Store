# n8n Webhook Integrations for UrbanNest Lifestyle Store
# In production, replace these with your active n8n production webhook endpoints.

# Webhook endpoint for the Customer Inquiry / Query Form
VITE_N8N_QUERY_FORM_URL=https://your-n8n-instance.com/webhook/urbannest-inquiry

# Webhook endpoint for the AI Lifestyle Concierge / Chatbot
VITE_N8N_CHATBOT_URL=https://your-n8n-instance.com/webhook/urbannest-chatbot
